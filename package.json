{
	"name": "itam-system",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:mobile": "cross-env BUILD_TARGET=mobile vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"prisma:generate": "prisma generate",
		"prisma:migrate": "prisma migrate deploy",
		"db:seed": "node scripts/seed.mjs",
		"db:local:init": "node scripts/local-pg.mjs init",
		"db:local:start": "node scripts/local-pg.mjs start",
		"db:local:stop": "node scripts/local-pg.mjs stop",
		"db:local:status": "node scripts/local-pg.mjs status"
	},
	"dependencies": {
		"@capacitor/android": "^7.0.0",
		"@capacitor/camera": "^7.0.0",
		"@capacitor/core": "^7.0.0",
		"@capacitor/geolocation": "^7.0.0",
		"@capacitor/network": "^7.0.0",
		"@capacitor/preferences": "^7.0.0",
		"@node-rs/argon2": "^2.0.2",
		"@prisma/client": "^6.6.0",
		"jose": "^6.0.10",
		"otpauth": "^9.3.6",
		"pino": "^9.6.0",
		"qrcode": "^1.5.4",
		"zod": "^3.24.2"
	},
	"devDependencies": {
		"@capacitor/cli": "^7.0.0",
		"@eslint/js": "^9.22.0",
		"@sveltejs/adapter-node": "^5.2.12",
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.19.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@tailwindcss/vite": "^4.0.14",
		"@types/node": "^22.13.10",
		"@types/qrcode": "^1.5.6",
		"cross-env": "^7.0.3",
		"eslint": "^9.22.0",
		"eslint-config-prettier": "^10.1.1",
		"eslint-plugin-svelte": "^3.2.2",
		"globals": "^16.0.0",
		"prettier": "^3.5.3",
		"prettier-plugin-svelte": "^3.3.3",
		"prisma": "^6.6.0",
		"svelte": "^5.23.0",
		"svelte-check": "^4.1.5",
		"tailwindcss": "^4.0.14",
		"typescript": "^5.8.2",
		"typescript-eslint": "^8.26.1",
		"vite": "^6.2.2",
		"vitest": "^3.0.8"
